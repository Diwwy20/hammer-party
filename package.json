{
  "name": "hammer-party",
  "version": "0.0.0",
  "private": true,
  "description": "PVP hammer battle-royale party game — web/mobile, Colyseus authoritative server + React Three Fiber clients",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @hammer/server --filter @hammer/client dev",
    "dev:server": "pnpm -F @hammer/server dev",
    "dev:client": "pnpm -F @hammer/client dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
