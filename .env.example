# --- server ---
# Port the Colyseus game server listens on
PORT=2567

# --- client (Vite, must be prefixed VITE_) ---
# WebSocket URL of the game server. Leave unset to auto-use ws://<current-host>:2567
# (handy on LAN: phones hit the same host that served the page).
# VITE_SERVER_URL=ws://192.168.1.50:2567
